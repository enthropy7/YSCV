{
  "assets": [
    {
      "path": "yolov8n.onnx",
      "env": "YSCV_BENCH_YOLOV8N_URL",
      "url": "https://huggingface.co/deepghs/yolos/resolve/main/yolov8n/model.onnx"
    },
    {
      "path": "yolo11n.onnx",
      "env": "YSCV_BENCH_YOLO11N_URL",
      "url": "https://huggingface.co/deepghs/yolos/resolve/main/yolo11n/model.onnx"
    },
    {
      "path": "resnet-18.onnx",
      "env": "YSCV_BENCH_RESNET18_URL",
      "url": "https://huggingface.co/onnx-community/resnet-18-ONNX/resolve/main/onnx/model.onnx"
    },
    {
      "path": "mobilenet-v3-small.onnx",
      "env": "YSCV_BENCH_MOBILENET_V3_SMALL_URL",
      "url": "https://huggingface.co/vlad-m-dev/mobilenet_v3_small_onnx_photo_doc/resolve/main/mobilenet_v3_small.onnx"
    },
    {
      "path": "people.jpg",
      "env": "YSCV_BENCH_PEOPLE_IMAGE_URL",
      "url": "https://raw.githubusercontent.com/ultralytics/ultralytics/refs/heads/main/ultralytics/assets/bus.jpg"
    }
  ],
  "defaults": {
    "runs": 3,
    "threads": 0
  },
  "cases": [
    {
      "name": "yolov8n_bus_640",
      "model": "yolov8n.onnx",
      "iters": 10,
      "iters_env": "YSCV_PR_BENCH_YOLO_ITERS",
      "inputs": [
        {
          "name": "images",
          "shape": [1, 3, 640, 640],
          "source": "image"
        }
      ],
      "image": "people.jpg",
      "image_input": "images",
      "image_size": 640
    },
    {
      "name": "yolo11n_bus_640",
      "model": "yolo11n.onnx",
      "iters": 10,
      "iters_env": "YSCV_PR_BENCH_YOLO_ITERS",
      "inputs": [
        {
          "name": "images",
          "shape": [1, 3, 640, 640],
          "source": "image"
        }
      ],
      "image": "people.jpg",
      "image_input": "images",
      "image_size": 640
    },
    {
      "name": "resnet18_224",
      "model": "resnet-18.onnx",
      "iters": 10,
      "iters_env": "YSCV_PR_BENCH_MODEL_ITERS",
      "fill": "random",
      "inputs": [
        {
          "name": "pixel_values",
          "shape": [1, 3, 224, 224],
          "source": "random"
        }
      ]
    },
    {
      "name": "mobilenet_v3_small_224",
      "model": "mobilenet-v3-small.onnx",
      "iters": 10,
      "iters_env": "YSCV_PR_BENCH_MODEL_ITERS",
      "fill": "random",
      "inputs": [
        {
          "name": "input",
          "shape": [1, 3, 224, 224],
          "source": "random"
        }
      ]
    },
    {
      "name": "small_conv_relu_64",
      "model": "small-conv-relu-64.onnx",
      "iters": 200,
      "iters_env": "YSCV_PR_BENCH_SMALL_ITERS",
      "fill": "random",
      "inputs": [
        {
          "name": "input",
          "shape": [1, 3, 64, 64],
          "source": "random"
        }
      ]
    },
    {
      "name": "small_dw_pw_64",
      "model": "small-dw-pw-64.onnx",
      "iters": 200,
      "iters_env": "YSCV_PR_BENCH_SMALL_ITERS",
      "fill": "random",
      "inputs": [
        {
          "name": "input",
          "shape": [1, 16, 64, 64],
          "source": "random"
        }
      ]
    },
    {
      "name": "small_residual_conv_64",
      "model": "small-residual-conv-64.onnx",
      "iters": 200,
      "iters_env": "YSCV_PR_BENCH_SMALL_ITERS",
      "fill": "random",
      "inputs": [
        {
          "name": "input",
          "shape": [1, 8, 64, 64],
          "source": "random"
        }
      ]
    },
    {
      "name": "small_gemm_relu_1x128",
      "model": "small-gemm-relu-1x128.onnx",
      "iters": 200,
      "iters_env": "YSCV_PR_BENCH_SMALL_ITERS",
      "fill": "random",
      "inputs": [
        {
          "name": "input",
          "shape": [1, 128],
          "source": "random"
        }
      ]
    },
    {
      "name": "winograd_3x3_80x80_c64",
      "model": "winograd-3x3-80x80-c64.onnx",
      "iters": 100,
      "iters_env": "YSCV_PR_BENCH_SMALL_ITERS",
      "fill": "random",
      "inputs": [
        {
          "name": "input",
          "shape": [1, 64, 80, 80],
          "source": "random"
        }
      ]
    },
    {
      "name": "winograd_3x3_20x20_c256",
      "model": "winograd-3x3-20x20-c256.onnx",
      "iters": 150,
      "iters_env": "YSCV_PR_BENCH_SMALL_ITERS",
      "fill": "random",
      "inputs": [
        {
          "name": "input",
          "shape": [1, 256, 20, 20],
          "source": "random"
        }
      ]
    },
    {
      "name": "gemm_relu_256x512x512",
      "model": "gemm-relu-256x512x512.onnx",
      "iters": 200,
      "iters_env": "YSCV_PR_BENCH_SMALL_ITERS",
      "fill": "random",
      "inputs": [
        {
          "name": "input",
          "shape": [256, 512],
          "source": "random"
        }
      ]
    }
  ]
}
